@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/Livox-SDK2Targets.cmake")

set(Livox-SDK2_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/include")
get_target_property(Livox-SDK2_SHARED_LIBRARY livox_sdk2::shared IMPORTED_LOCATION)
get_target_property(Livox-SDK2_STATIC_LIBRARY livox_sdk2::static IMPORTED_LOCATION)
set(Livox-SDK2_LIBRARIES livox_sdk2::shared)
